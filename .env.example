# Project Alpha - environment configuration
# Copy this file to .env and fill in the keys you have. Every source below
# has a free tier; the system degrades gracefully (skips a module / marks a
# feature as unavailable) when a key is missing, per the "cout nul" principle.

# --- SEC EDGAR (fundamentals, US) -----------------------------------------
# No API key required, but SEC requires a descriptive User-Agent with contact info.
SEC_EDGAR_USER_AGENT="Project Alpha personal-use research@example.com"

# --- AMF / Info-financiere (France, regulated disclosures) ----------------
# No API key required (open access).

# --- FRED / ALFRED (US macro) ----------------------------------------------
FRED_API_KEY=

# --- ECB Data Portal (EU macro) --------------------------------------------
# No API key required (open SDW REST API).

# --- Massive / Polygon Free (US prices, EOD) --------------------------------
MASSIVE_API_KEY=

# --- Twelve Data Free (multi-market prices, cross-check) -------------------
TWELVE_DATA_API_KEY=

# --- Finnhub Free (market/news/calendar) ------------------------------------
FINNHUB_API_KEY=

# --- GNews Free (general news) ----------------------------------------------
GNEWS_API_KEY=

# --- Financial Modeling Prep Free (secondary fundamentals) ------------------
FMP_API_KEY=

# --- LLM / Research agent ----------------------------------------------------
ANTHROPIC_API_KEY=

# --- Local storage ------------------------------------------------------------
PROJECT_ALPHA_DATA_DIR=./data/warehouse
